# Copy to .env.local for development. In production these are injected by
# Secret Manager into the Cloud Run service's environment — never committed.

# Single Phase 1 admin account (Admin.md §3.4, §17.2).
ADMIN_EMAIL=admin@justicefund.org.au
# Generate with: node scripts/create-admin-hash.mjs "your-password"
# Local .env.local only: escape every "$" as "\$" — Next's dotenv-expand
# treats an unescaped "$" as variable interpolation and mangles the hash.
# Not needed when Secret Manager injects this directly as a Cloud Run env
# var in production (no dotenv parsing happens there).
ADMIN_PASSWORD_HASH=

# HMAC signing secret for admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Supabase (Phase 2 content persistence — replaces the local data/*.json
# storage adapter behind the same ContentStorage interface).
# Project URL + anon key: safe to expose to the browser, respects RLS.
# From Supabase dashboard: Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: bypasses RLS entirely. Server-only — never prefix with
# NEXT_PUBLIC_, never import it into a client component, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# Admin MFA email delivery (SendGrid SMTP relay). Server-only — never
# prefix with NEXT_PUBLIC_, never log SMTP_PASSWORD. Without these set,
# login falls back to no-MFA (see src/lib/auth/mfa.ts isMfaConfigured()).
SMTP_HOST=smtp.sendgrid.net
# 465 (implicit TLS) if your network blocks 587 (STARTTLS) outbound.
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
# Must be a verified Sender Identity in the SendGrid account (Settings ->
# Sender Authentication) or SendGrid rejects the send with a 550 error.
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="Intergenerational Justice Fund"
